[user]
	name = Pranaya Deomani
	email = mail@pranaya.dev
	signingKey = 370A31FC9F6948FC
[color]
	ui = auto
[commit]
	gpgSign = true
[core]
	pager = LESS='FR --redraw-on-quit' delta
[delta]
	hyperlinks = true
	line-numbers = true
	navigate = true
[diff]
	colorMoved = default
	external = difft
[fetch]
	negotiationAlgorithm = skipping
[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	smudge = git-lfs smudge -- %f
	required = true
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = diff3
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
[push]
	autoSetupRemote = true
[tag]
	gpgSign = true
